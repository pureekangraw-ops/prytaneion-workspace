{
  "release": "go-hub-v4-cutover-1",
  "product": "GO Hub",
  "releaseDate": "2026-09-24",
  "rootEntry": "index.html",
  "features": [
    "GO Hub neutral root control surface",
    "dedicated GO Hub PWA identity",
    "dedicated GO Hub service worker",
    "offline GO Hub root startup",
    "provider-neutral Code capability",
    "GitHub-backed Code workspace through trusted same-origin gateway",
    "durable CENTRE checkpoint before destination access",
    "single CENTRE entry and return passage for GO",
    "explicit repository-neutral Work Target routing into LIGHTHOUSE through Factory",
    "Centre-backed durable Work Index with restart-safe resume",
    "Heimdall Work registry, holder, scoped Passes, Warp, and three-way Project Board",
    "Factory V4 PLAN → BUILD → ASSEMBLY → MERGE → CHECK → OUTPUT lifecycle",
    "Maintenance V4 persisted Map, safe probes, first-break readback, and closeout plan",
    "Counter → LIGHT → Work → Answer → Readback continuity",
    "GO Control Room live cross-system correlation surface",
    "PIXIE Visual Workbench: IDEA/REFERENCE + BRIEF/PROMPT + MAIN WORKSPACE with local render-packet preparation",
    "GO Project Viewer: read-only Hub + Factory + Updates live surface"
  ],
  "serviceWorker": {
    "file": "go-hub-sw.js",
    "mode": "go-hub-exclusive",
    "cachePrefix": "go-hub-app-",
    "cacheGeneration": "v12-go-hub-v4-cutover",
    "autoActivate": true
  },
  "validation": {
    "command": "npm run deploy:gate",
    "scope": [
      "GO Hub hard-cutover contracts",
      "GO Hub runtime boundaries",
      "GO Hub Code capability boundary",
      "active publication parity",
      "syntax",
      "utf8",
      "no executable ride references",
      "CENTRE checkpoint identity and destination gate",
      "one active owner per concern",
      "V4 Pass scope, expiry, close condition, and Return Address",
      "Factory/Maintenance runtime readback and legacy caller quarantine"
    ]
  },
  "note": "GO Hub V4 keeps Centre as the durable Work owner. Heimdall is the Work registry, holder, Pass, Warp, and three-way Project Board read model; Factory and Maintenance retain workspace truth; Counter owns LIGHT tickets; Audit is immutable history. Evidence acceptance, RCA, and repair authority are not part of Heimdall.",
