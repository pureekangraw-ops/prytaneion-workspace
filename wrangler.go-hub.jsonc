{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "go-hub",
  "main": "go-hub-edge-worker.mjs",
  "compatibility_date": "2026-09-14",
  "keep_vars": true,
  "browser": {
    "binding": "BROWSER"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "HEPHAESTUS",
        "class_name": "HephaestusForeman"
      },
      {
        "name": "GO_HUB_FACTORY_STATE",
        "class_name": "GoHubFactoryState"
      },
      {
        "name": "GO_HUB_PIXIE_MONITOR_STATE",
        "class_name": "GoHubPixieMonitorState"
      },
      {
        "name": "GO_HUB_CENTRE_STATE",
        "class_name": "GoHubCentreState"
      },
      {
        "name": "LIGHTHOUSE_CONTROL_PORT_SESSIONS",
        "class_name": "LighthouseControlPortSessionRegistry"
      },
      {
        "name": "OBSERVER_SESSIONS",
        "class_name": "ObserverSessionRegistry"
      },
      {
        "name": "FACTORY_EYE_SESSIONS",
        "class_name": "FactoryEyeSessionRegistry"
      },
      {
        "name": "GO_HUB_GLOBAL_AUDIT",
        "class_name": "GoHubGlobalAuditLog"
      },
      {
        "name": "GO_HUB_OFFICE_RATE_LIMIT",
        "class_name": "OfficeRateLimitState"
      },
      {
        "name": "GO_HUB_COUNTER_STATE",
        "class_name": "GoHubCounterState"
      },
      {
        "name": "GO_HUB_COUNTER_INBOX",
        "class_name": "GoHubCounterInboxState"
      },
      {
        "name": "GO_HUB_COUNTER_DISPATCH_STATE",
        "class_name": "GoHubCounterDispatchState"
      },
      {
        "name": "GO_HUB_NOTION_LIGHT_STATE",
        "class_name": "GoHubNotionLightState"
      },
      {
        "name": "GO_HUB_MAINTENANCE_STATE",
        "class_name": "GoHubMaintenanceState"
      },
      {
        "name": "GO_HUB_BROADCAST_STATE",
        "class_name": "GoHubBroadcastState"
      },
      {
        "name": "GO_HUB_OFFICE_PASSKEY",
        "class_name": "OfficePasskeyState"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-hephaestus-foreman",
      "new_sqlite_classes": [
        "HephaestusForeman"
      ]
    },
    {
      "tag": "v2-factory-task-state",
      "new_sqlite_classes": [
        "GoHubFactoryState"
      ]
    },
    {
      "tag": "v3-browser-observer-sessions",
      "new_sqlite_classes": [
        "ObserverSessionRegistry"
      ]
    },
    {
      "tag": "v4-centre-live-state",
      "new_sqlite_classes": [
        "GoHubCentreState"
      ]
    },
    {
      "tag": "v5-lighthouse-control-port-session",
      "new_sqlite_classes": [
        "LighthouseControlPortSessionRegistry"
      ]
    },
    {
      "tag": "v6-global-audit-log",
      "new_sqlite_classes": [
        "GoHubGlobalAuditLog"
      ]
    },
    {
      "tag": "v7-go-light-counter-state",
      "new_sqlite_classes": [
        "GoHubCounterState"
      ]
    },
    {
      "tag": "v8-go-light-counter-dispatch-state",
      "new_sqlite_classes": [
        "GoHubCounterDispatchState"
      ]
    },
    {
      "tag": "v9-go-light-notion-mcp-state",
      "new_sqlite_classes": [
        "GoHubNotionLightState"
      ]
    },
    {
      "tag": "v10-go-light-counter-inbox",
      "new_sqlite_classes": [
        "GoHubCounterInboxState"
      ]
    },
    {
      "tag": "v11-go-hub-maintenance-state",
      "new_sqlite_classes": [
        "GoHubMaintenanceState"
      ]
    },
    {
      "tag": "v12-go-hub-broadcast-state",
      "new_sqlite_classes": [
        "GoHubBroadcastState"
      ]
    },
    {
      "tag": "v13-go-hub-pixie-monitor",
      "new_sqlite_classes": [
        "GoHubPixieMonitorState"
      ]
    },
    {
      "tag": "v14-ergasterion-factory-eye",
      "new_sqlite_classes": [
        "FactoryEyeSessionRegistry"
      ]
    },
    {
      "tag": "v15-office-rate-limit",
      "new_sqlite_classes": [
        "OfficeRateLimitState"
      ]
    },
    {
      "tag": "v16-office-passkey",
      "new_sqlite_classes": [
        "OfficePasskeyState"
      ]
    }
  ],
  "vars": {
    "GO_HUB_CARD_ACCESS_V2": "1",
    "ERGASTERION_FACTORY_URL": "https://ergasterion-factory.pureekangraw.workers.dev",
    "LIGHT_BELL_PAGE_ID": "88970e1da0a64ceebaa1ac1928361911",
    "COUNTER_HANDOFF_AGENT_URL": "agent://1277043d-9861-8158-a732-000347bf2bab/3e27043d-9861-8026-8e4b-009237cacaec",
    "MIRROR_REFRESH_AGENT_URL": "agent://1277043d-9861-8158-a732-000347bf2bab/3e27043d-9861-800e-9b05-00926ce24c3a",
    "BROWSER_POLICY": {
      "allowedHostnames": [
        "gumroad.com",
        "*.gumroad.com"
      ],
      "requireOwnerPasscode": true
    }
  },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/",
      "/office",
      "/office/*",
      "/hub/api/centre/*",
      "/hub/api/counter/*",
      "/hub/api/lighthouse-control-port/*",
      "/hub/lighthouse",
      "/hub/prism/pairing",
      "/hub/api/browser/*",
      "/hub/api/factory-eye/*",
      "/hub/api/github-workspace/*",
      "/hub/api/notion-light/*",
      "/hub/observer",
      "/hub/light-mcp",
      "/mcp",
      "/mcp/*",
      "/oauth/*",
      "/.well-known/*",
      "/internal/*"
    ]
  },
  "r2_buckets": [
    {
      "binding": "OFFICE_ASSETS",
      "bucket_name": "ygg-office-assets"
    },
    {
      "binding": "GO_HUB_CENTRE_OBJECTS",
      "bucket_name": "hubcentre"
    }
  ],
  "services": [
    {
      "binding": "ERGASTERION_FACTORY",
      "service": "ergasterion-factory"
    },
    {
      "binding": "OLYMPUS_SERVICE",
      "service": "olympus"
    }
  ]
}
